# Git
.git
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Data (large files)
data/raw/*
data/processed/*
data/synthetic/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/synthetic/.gitkeep

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# MyPy
.mypy_cache/
.dmypy.json

# Ruff
.ruff_cache/

# LangSmith
.langsmith/

# Logs
*.log
logs/

# Frontend and screenshots (the frontend has its own Docker build context)
frontend/
frontend/node_modules/
frontend/build/
frontend/dist/

# Local agent skills and generated artifacts
.agents/
skills-lock.json

# Runtime data and documentation are not needed in the API/MCP build context
data/
docs/

# Docker
.docker/
docker-compose.override.yml
